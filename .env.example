# Required on Vercel (Production + Preview)
DATABASE_URL=postgresql://user:password@host:5432/focusarx
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Required for /admin routes in production
ADMIN_PASSWORD=your-strong-admin-password

# Optional
ANTHROPIC_API_KEY=
LOG_LEVEL=info

# Vite (defaults in vite.config.ts if unset)
PORT=20925
BASE_PATH=/
