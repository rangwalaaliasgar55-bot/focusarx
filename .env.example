# ── Required (production) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
AUTH_SECRET=your-32+-char-random-secret

# Canonical public URL (OAuth redirects, password reset links, CORS)
# On Vercel, VERCEL_URL is used automatically if APP_URL is unset.
APP_URL=https://your-app.vercel.app

# ── Admin panel ───────────────────────────────────────────────────────────────
# Password for /admin gate (bootstrap access). Users with role=admin in the DB
# can also access admin APIs when signed in with a normal JWT.
ADMIN_PASSWORD=your-secure-admin-password

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Password reset email (optional) ───────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# ── AI features (optional) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Legacy / alternate JWT secret name (optional) ─────────────────────────────
# SESSION_SECRET=same-as-auth-secret-if-migrating-from-nextauth

# ── Local dev only ────────────────────────────────────────────────────────────
# PORT=5173
# BASE_PATH=/
# NODE_ENV=development
# LOG_LEVEL=info
