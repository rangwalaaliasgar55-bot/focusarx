# SQLite database used by Prisma
# For local development, this works with the SQLite file under prisma/dev.db.
# For Vercel production, SQLite is not persistent on the deployment filesystem.
# Use a remote database connection instead, such as Postgres, MySQL, or Vercel Postgres.
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth signing secret.
# Required in production. Local `next dev` falls back to a dev-only secret if unset.
AUTH_SECRET="replace-with-a-long-random-string"

# Admin control panel (/admin). Set a strong password; never commit the real value.
ADMIN_PASSWORD="your-admin-password-here"

# Optional: separate signing key for admin cookies (defaults to AUTH_SECRET)
# ADMIN_SECRET="another-long-random-string"

# Optional: enables real AI responses for /api/ai/coach and /api/ai/roadmap.
# Without this key, those routes return local mock/fallback responses.
# OPENAI_API_KEY="sk-..."

# Firebase Web App Configuration
# Get these values from Firebase Console > Project Settings > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Android/Capacitor development server URL:
# Emulator -> http://10.0.2.2:3000
# Physical device -> http://YOUR_COMPUTER_LAN_IP:3000
# Production APK -> https://your-production-domain.com
CAPACITOR_SERVER_URL=
CAPACITOR_WEBVIEW_DEBUG=false
