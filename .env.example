# ── FocusArx Environment Variables ─────────────────────────────────────────
# Format: Each variable is marked with:
#   - SERVER_ONLY / PUBLIC  — visibility scope
#   - REQUIRED / OPTIONAL   — whether it must be set
#
# NEVER commit real credentials. Copy this file to .env and fill in values.
# ────────────────────────────────────────────────────────────────────────────

# ── Required (production) ───────────────────────────────────────────────────
# SERVER_ONLY | REQUIRED
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# SERVER_ONLY | REQUIRED
AUTH_SECRET=your-32+-char-random-secret

# SERVER_ONLY | REQUIRED
# Canonical public URL (OAuth redirects, password reset links, CORS).
# Production value: https://focusarx.site — MUST match the canonical host
# used by the frontend (VITE_APP_URL) and the sitemap, or every sitemap
# URL becomes a cross-host duplicate of its canonical.
# On Vercel, VERCEL_URL is used automatically if APP_URL is unset.
APP_URL=https://focusarx.site

# ── Admin panel ───────────────────────────────────────────────────────────────
# SERVER_ONLY | REQUIRED
# Password for /admin gate (bootstrap access). Users with role=admin in the DB
# can also access admin APIs when signed in with a normal JWT.
# Must be at least 8 characters (same floor as user passwords; enforced by lib/env.ts).
ADMIN_PASSWORD=your-secure-admin-password

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# SERVER_ONLY | OPTIONAL
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SERVER_ONLY | OPTIONAL
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email — Resend (recommended) ──────────────────────────────────────────────
# SERVER_ONLY | OPTIONAL
# Powers password-reset links, admin blasts, contact notifications and
# moderation digests. Without it, email falls back to SMTP below.
# RESEND_API_KEY=re_...

# SERVER_ONLY | OPTIONAL
# EMAIL_FROM="FocusArx <noreply@your-domain.com>"

# ── Email — SMTP fallback (optional, used only when RESEND_API_KEY is unset) ──
# SERVER_ONLY | OPTIONAL
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@your-domain.com

# ── Distributed premium cache (optional; Upstash Redis) ──────────────────────
# SERVER_ONLY | OPTIONAL
# Optional — when set, rate limiting uses this shared Redis store so counters
# are global across serverless instances (otherwise per-instance in-memory).
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── AI features (optional — app degrades gracefully without them) ─────────────
# SERVER_ONLY | OPTIONAL
# Powers the AI coach, flashcard generation, insights and LLM content
# moderation. Without it, AI requests return a safe unavailable response;
# the core timer, tasks, and saved work continue to function.
# GROQ_API_KEY=gsk_...

# SERVER_ONLY | OPTIONAL
# Powers the AI study-roadmap generator. Without it, the AI endpoint
# returns a safe unavailable response; no generated-looking plan is invented.
# GEMINI_API_KEY=your-gemini-key

# ── Web push (optional) ───────────────────────────────────────────────────────
# PUBLIC (VAPID_PUBLIC_KEY is exposed to the browser for push subscription)
# VAPID_PUBLIC_KEY=...

# SERVER_ONLY | OPTIONAL
# VAPID_PRIVATE_KEY=...

# SERVER_ONLY | OPTIONAL
# VAPID_EMAIL=mailto:you@example.com

# ── Scheduled jobs (optional) ─────────────────────────────────────────────────
# SERVER_ONLY | OPTIONAL
# Bearer secret Vercel Cron sends to GET /api/retention/reengage/run
# (win-back push digests). Vercel attaches `Authorization: Bearer $CRON_SECRET`
# automatically when set; the endpoint is a no-op 503 otherwise.
# CRON_SECRET=your-cron-secret

# ── Legacy / alternate JWT secret name (optional) ─────────────────────────────
# SERVER_ONLY | OPTIONAL
# SESSION_SECRET=same-as-auth-secret-if-migrating-from-nextauth

# ── Optional privileged SQL console (disabled by default) ────────────────────
# SERVER_ONLY | OPTIONAL
# The console is off unless this is exactly true. Read queries then become
# available to authenticated admins; writes additionally require the unique
# secret below. Keep the secret in a password manager — it is never shown in UI.
# ENABLE_ADMIN_SQL=true
# SQL_UNLOCK_PHRASE=generate-a-unique-16-plus-character-secret

# ── Local dev only ────────────────────────────────────────────────────────────
# SERVER_ONLY | OPTIONAL (dev only)
# `pnpm dev` loads this root .env for the API and starts it on 8080 by default.
# The Vite frontend starts independently on http://localhost:5173 and proxies
# /api and /socket.io to 8080. Do not set a shared PORT in this file: it can
# make Vite and the API compete for one listener. To use a non-default API port,
# start that process with PORT=<port> and set API_PROXY_TARGET for Vite separately.
# API_PROXY_TARGET=http://127.0.0.1:8080
# BASE_PATH=/
# NODE_ENV=development
# LOG_LEVEL=info

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# PUBLIC | OPTIONAL
# Canonical origin used for SEO meta (canonical / og:url / og:image / sitemap).
# Defaults to https://focusarx.site. Set this to your actual deployment origin
# so structured data and social cards never point at the wrong domain.
# VITE_APP_URL=https://focusarx.site

# ── Analytics & Search Console ────────────────────────────────────────────────
# PUBLIC | OPTIONAL
# Google Analytics 4 is installed globally in artifacts/focusarx/index.html.
# The production measurement ID is G-PXMVX28PL5; no VITE_GA_MEASUREMENT_ID is required.

# PUBLIC | OPTIONAL
# Google Search Console: after verifying your domain, paste the verification
# meta tag's `content` value into the <head> of artifacts/focusarx/index.html
# (search for "google-site-verification").
