# ── Required (production) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
AUTH_SECRET=your-32+-char-random-secret

# Canonical public URL (OAuth redirects, password reset links, CORS)
# On Vercel, VERCEL_URL is used automatically if APP_URL is unset.
APP_URL=https://your-app.vercel.app

# ── Admin panel ───────────────────────────────────────────────────────────────
# Password for /admin gate (bootstrap access). Users with role=admin in the DB
# can also access admin APIs when signed in with a normal JWT.
ADMIN_PASSWORD=your-secure-admin-password

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email — Resend (recommended) ──────────────────────────────────────────────
# Powers password-reset links, admin blasts, contact notifications and
# moderation digests. Without it, email falls back to SMTP below.
# RESEND_API_KEY=re_...
# EMAIL_FROM="FocusArx <noreply@your-domain.com>"

# ── Email — SMTP fallback (optional, used only when RESEND_API_KEY is unset) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@your-domain.com

# ── Distributed premium cache (optional; Upstash Redis) ──────────────────────
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── AI features (optional — app degrades gracefully without them) ─────────────
# Powers the AI coach, flashcard generation, insights and LLM content
# moderation. Without it, keyword moderation + template responses are used.
# GROQ_API_KEY=gsk_...

# Powers the AI study-roadmap generator. Without it, a local template
# roadmap is produced instead.
# GEMINI_API_KEY=your-gemini-key

# ── Web push (optional) ───────────────────────────────────────────────────────
# Without these, ephemeral VAPID keys are generated per boot and push
# subscriptions break across restarts. Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_EMAIL=mailto:you@example.com

# ── Scheduled jobs (optional) ─────────────────────────────────────────────────
# Bearer secret Vercel Cron sends to GET /api/retention/reengage/run
# (win-back push digests). Vercel attaches `Authorization: Bearer $CRON_SECRET`
# automatically when set; the endpoint is a no-op 503 otherwise.
# CRON_SECRET=your-c…cret

# ── Legacy / alternate JWT secret name (optional) ─────────────────────────────
# SESSION_SECRET=same-as-auth-secret-if-migrating-from-nextauth

# ── Local dev only ────────────────────────────────────────────────────────────
# PORT=5173
# BASE_PATH=/
# NODE_ENV=development
# LOG_LEVEL=info

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Canonical origin used for SEO meta (canonical / og:url / og:image / sitemap).
# Defaults to https://focusarx.site. Set this to your actual deployment origin
# so structured data and social cards never point at the wrong domain.
# VITE_APP_URL=https://focusarx.site

# ── Analytics & Search Console ────────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When set, gtag.js is
# loaded and SPA page views + sign_up/login events are sent to GA4.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console: after verifying your domain, paste the verification
# meta tag's `content` value into the <head> of artifacts/focusarx/index.html
# (search for "google-site-verification").
