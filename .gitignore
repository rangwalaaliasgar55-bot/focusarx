/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.next

# production
/build
dist

# misc
.DS_Store
Thumbs.db
*.pem
*.tar.gz
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# prisma local db
/prisma/*.db
/prisma/*.db-journal
/prisma/prisma/*.db
/prisma/prisma/*.db-journal

# vercel
.vercel

# capacitor / android generated files
/android/app/build/
/android/build/
/android/capacitor-cordova-android-plugins/build/
/android/.gradle/
/android/**/.gradle/
/android/local.properties
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json

# typescript
*.tsbuildinfo
next-env.d.ts
