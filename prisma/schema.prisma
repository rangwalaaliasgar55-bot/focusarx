generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String?
  name           String?
  guestKey  String?  @unique
  isGuest   Boolean  @default(false)
  xp        Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())

  focusSessions    FocusSession[]
  tasks            Task[]
  studyStreak      StudyStreak?
  goals            Goal[]
  settings         UserSettings?
  userAchievements UserAchievement[]
}

model FocusSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             String
  status           String    @default("completed")
  durationSec      Int       @default(0)
  activeSeconds    Int       @default(0)
  secondsLeft      Int?
  timerStatus      String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  clientNonce      String?   @unique
  focusScore       Int?
  focusQuality     String?
  focusState       String?
  distractionCount Int       @default(0)
  lastSeenFaceAt   DateTime?
  focusTimeline    String?
  stabilityRating  String?
  sessionInsights  String?
  monitorEnabled   Boolean   @default(false)
  taskId           String?
  task             Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt])
  @@index([userId, status])
}

model Task {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  completed           Boolean        @default(false)
  estimatedPomodoros  Int            @default(1)
  completedPomodoros  Int            @default(0)
  createdAt           DateTime       @default(now())
  focusSessions       FocusSession[]

  @@index([userId])
}

model StudyStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastStudyDate  DateTime?
  totalStudyDays Int       @default(0)
}

model Goal {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  targetSessions    Int
  completedSessions Int      @default(0)
  goalDate          DateTime

  @@index([userId, goalDate])
}

model UserSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusDuration     Int     @default(1500)
  breakDuration     Int     @default(300)
  longBreakDuration Int     @default(900)
  soundEnabled      Boolean @default(true)
  theme             String  @default("dark")
  autoStart         Boolean @default(false)
}

model Achievement {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String
  xpReward    Int                 @default(0)
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}
