{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "push": "node ./scripts/cleanup-orphans.mjs && node ./scripts/push.mjs",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "push:vercel": "node ./scripts/push-vercel.mjs",
    "test:db": "node ./scripts/test-db.mjs",
    "seed": "node ./scripts/seed.mjs",
    "seed:clear": "node ./scripts/seed.mjs --clear",
    "validate-migrations": "node ./scripts/validate-migrations.mjs",
    "test:migrations": "node ./scripts/replay-migrations.mjs",
    "schema:export": "node ./scripts/export-schema.mjs",
    "schema:check": "node ./scripts/export-schema.mjs --check"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
