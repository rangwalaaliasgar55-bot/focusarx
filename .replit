modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FocusArx Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FocusArx API"

[[workflows.workflow]]
name = "FocusArx Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=20925 BASE_PATH=/ pnpm --filter @workspace/focusarx run dev"
waitForPort = 20925

[[workflows.workflow]]
name = "FocusArx API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_anthropic_ai_integrations:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20925
externalPort = 80

[[ports]]
localPort = 20926
externalPort = 3000

[userenv]

[userenv.shared]
APP_URL = "https://ffdf8732-c649-4a2d-bd32-be36a9cc6c89-00-1ltipucvjv43f.sisko.replit.dev"

[nix]
channel = "stable-25_05"
