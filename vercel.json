{
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "artifacts/focusarx/dist/public",
  "ignoreCommand": "",
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
