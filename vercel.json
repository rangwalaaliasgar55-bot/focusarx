{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "artifacts/focusarx/dist/public",
  "trailingSlash": false,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "artifacts/api-server/dist/app.mjs",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.mjs"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/index.mjs",
      "headers": {
        "Cache-Control": "public, max-age=3600, s-maxage=21600"
      }
    },
    {
      "src": "/sitemap-[^/]+\\.xml",
      "dest": "/api/index.mjs",
      "headers": {
        "Cache-Control": "public, max-age=1800, s-maxage=43200"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/u/[^/]+",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/assets/.*",
      "status": 404
    },
    {
      "src": "/(?:.*/)?[^/]*\\.[A-Za-z0-9]{1,10}$",
      "status": 404
    },
    {
      "src": "/([-A-Za-z0-9._~%/@]*[A-Z][-A-Za-z0-9._~%/@]*)",
      "dest": "/api/index.mjs?canonicalize=/$1"
    },
    {
      "src": "/(admin|ai-insights|analytics|auth/callback|battle-pass|city|consequences|constellations|dashboard|data-deletion|developer|dna|dreams|flashcards|focus-dna|forge|forge-room|forgot-password|go/ig|goals|groups|habits|lootboxes|marketplace|messages|missions|notifications|onboarding|pets|profile|quests|referral|reset-password|shop|social|tasks|wallet|welcome)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "focusarx.site"
        }
      ],
      "destination": "https://www.focusarx.site/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:woff2?|ttf|otf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|webp|avif|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(manifest\\.json|ads\\.txt|BingSiteAuth\\.xml|llms\\.txt|humans\\.txt|feed\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/sw\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), interest-cohort=(), browsing-topics=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/retention/reengage/run",
      "schedule": "0 9 * * *"
    }
  ]
}
