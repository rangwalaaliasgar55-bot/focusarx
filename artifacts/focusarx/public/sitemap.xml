<?xml version="1.0" encoding="UTF-8"?>
<!--
  FocusArx sitemap INDEX — static fallback.

  In production vercel.json rewrites /sitemap.xml to the API function, which
  emits this same index (see artifacts/api-server/src/routes/sitemap.ts).
  This static copy is the fallback so the root URL never resolves to SPA HTML
  if the function cold-starts or fails.

  KEEP THIS LIST IDENTICAL TO `SEGMENTS` IN sitemap.ts — files AND lastmod
  dates. The seoContract test fails the build if either drifts. Each date is the
  newest review date inside that segment (see the lastmod tables in sitemap.ts);
  sitemap-legal.xml has none, because no policy page has a dated review, and a
  guessed lastmod costs more credibility than an omitted one.

  Canonical host is www.focusarx.site — the static file and the API
  must agree on host, or every URL becomes a cross-host duplicate.

  There is deliberately NO sitemap-profiles-*.xml entry here: /u/<name>
  profiles are noindex and out of the sitemap (see the header comment in
  sitemap.ts for the evidence behind that call).
-->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://www.focusarx.site/sitemap-core.xml</loc>
    <lastmod>2026-09-11</lastmod>
  </sitemap>
  <sitemap>
    <loc>https://www.focusarx.site/sitemap-tools.xml</loc>
    <lastmod>2026-09-08</lastmod>
